# Copy this file to .dev.vars (already gitignored) for local wrangler dev.
GOOGLE_DRIVE_API_KEY=your_api_key_here

# Google People API OAuth2 credentials for the newsletter email signup. These add
# subscribers to the "Newsletter" contacts label under secretary.purduechipsi@gmail.com.
# The newsletter-signup function exchanges the refresh token for a short-lived
# access token on each request, so the access token never has to be stored.
# Scope needed: https://www.googleapis.com/auth/contacts
GOOGLE_PEOPLE_CLIENT_ID=your_oauth_client_id_here
GOOGLE_PEOPLE_CLIENT_SECRET=your_oauth_client_secret_here
GOOGLE_PEOPLE_REFRESH_TOKEN=your_oauth_refresh_token_here
